{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/CHANGELOG.md",
    "docs/.vitepress/cache/**"
  ]
}
