{
  "name": "@actorium/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:api": "node .vitepress/generate-api.mjs",
    "docs:showcase": "node .vitepress/record-showcase.mjs",
    "docs:dev": "pnpm run docs:api && pnpm run docs:showcase && vitepress dev",
    "docs:build": "pnpm run docs:api && pnpm run docs:showcase && vitepress build",
    "docs:preview": "vitepress preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@actorium/xstate-otel": "workspace:*",
    "@actorium/xstate-otel-showcase": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/node": "catalog:",
    "mermaid": "11.17.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "catalog:",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.45",
    "xstate": "catalog:"
  }
}
