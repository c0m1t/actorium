{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@actorium/xstate-otel": ["../packages/xstate-otel/src/index.ts"]
    }
  },
  "include": ["snippets/**/*.ts", ".vitepress/**/*.ts", "**/*.data.ts"]
}
