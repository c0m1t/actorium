{
  "name": "@actorium/xstate-otel-showcase",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @actorium/xstate-otel run build && node src/main.ts",
    "record": "pnpm --filter @actorium/xstate-otel run build && node src/record.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@actorium/xstate-otel": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "typescript": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./viewer": "./src/viewer.js",
    "./viewer.css": "./src/viewer.css",
    "./source-links": "./src/source-links.ts"
  }
}
