{
  "name": "actorium-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "check:package": "pnpm -r --if-present run check:package",
    "check:unused": "knip",
    "docs:dev": "pnpm --filter @actorium/docs run docs:dev",
    "docs:build": "pnpm --filter @actorium/docs run docs:build",
    "test:compatibility": "pnpm --filter @actorium/xstate-otel run test:compatibility --",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package && pnpm run check:unused && pnpm run docs:build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "knip": "6.44.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25"
  }
}
